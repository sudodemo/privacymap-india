      "id": "SEC-001",
      "title": "Personal data stored on a personal/employee device",
      "finding_type": "SECURITY_REVIEW",
      "severity": "HIGH",
      "conditions": [
        "storage in MOBILE_PHONE or storage in LAPTOP where device is personal"
      ]
